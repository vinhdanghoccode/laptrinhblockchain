jspm_packages/
.pnp
.pnp.js

# ─── 2. Environment Variables & Secrets ──────────────────────
.env
.env.local
.env.*.local
*.env
!.env.example

# ─── 3. Blockchain Frameworks Build & Cache ──────────────────
# Hardhat
artifacts/
cache/
typechain/
typechain-types/

# Truffle
build/

# ─── 4. Coverage, Testing & Metrics ──────────────────────────
coverage/
coverage.json
.nyc_output/
*.lcov

# ─── 5. Logs & Temporary Process Files ───────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# ─── 6. Editor & IDE Settings ────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ─── 7. OS Generated Files ───────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── 8. Office Temporary Lock Files ──────────────────────────
~$*.docx
~$*.doc
~$*.xlsx
~$*.pptx

# ─── 9. Scratch & Temporary Scripts ──────────────────────────
scratch_*.py
temp_*.js
