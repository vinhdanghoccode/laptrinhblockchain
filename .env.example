# Tệp cấu hình môi trường — sao chép thành .env và điền thông tin thực

# RPC URL từ Alchemy hoặc Infura (Sepolia testnet)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key ví deploy (KHÔNG commit file .env lên git)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# API key Etherscan để verify contract
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Địa chỉ contract sau khi deploy (điền sau)
CONTRACT_ADDRESS=

# Cổng backend server
PORT=3000
